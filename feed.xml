---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
{% assign posts = site.pages | where: 'layout', 'post' | sort: 'date' | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}{{ '/' | relative_url }}" />
  <link href="{{ site.url }}{{ '/feed.xml' | relative_url }}" rel="self" />
  <id>{{ site.url }}{{ '/' | relative_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% for post in posts limit: 20 %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <link href="{{ site.url }}{{ post.url | relative_url }}" />
      <id>{{ site.url }}{{ post.url | relative_url }}</id>
      <updated>{{ post.date | date_to_xmlschema }}</updated>
      <summary>{{ post.description | xml_escape }}</summary>
    </entry>
  {% endfor %}
</feed>
