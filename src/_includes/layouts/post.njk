---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-header">
    <p class="post-kicker">{{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="post-description">{{ description }}</p>
    <div class="post-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {% if readingTime %}<span>{{ readingTime }}</span>{% endif %}
    </div>
    {% if topics %}
      <ul class="tag-list" aria-label="文章标签">
        {% for topic in topics %}
          <li>{{ topic }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <a href="{{ '/归档/' | url }}">查看全部文章</a>
  </footer>

  <section class="comments" aria-labelledby="comments-title">
    <div class="comments-heading">
      <p class="eyebrow">Comments</p>
      <h2 id="comments-title">留言评论</h2>
    </div>
    <script src="https://giscus.app/client.js"
            data-repo="Ebola-Chan-bot/Ebola-Chan-bot.github.io"
            data-repo-id="R_kgDOSdEsuQ"
            data-category="Announcements"
            data-category-id="DIC_kwDOSdEsuc4C9BfJ"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
    </script>
  </section>
</article>
