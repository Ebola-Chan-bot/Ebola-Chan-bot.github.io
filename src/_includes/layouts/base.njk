<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description | escape }}">
    <meta name="theme-color" content="#fafafa">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="{{ '/' | url }}" aria-label="{{ site.title }} 首页">
        <span class="brand-mark" aria-hidden="true">EC</span>
        <span class="brand-text">{{ site.title }}</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <a href="{{ '/' | url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>首页</a>
        <a href="{{ '/归档/' | url }}" {% if page.url == '/归档/' %}aria-current="page"{% endif %}>归档</a>
        <a href="{{ '/关于/' | url }}" {% if page.url == '/关于/' %}aria-current="page"{% endif %}>关于</a>
      </nav>
    </header>

    <main class="site-main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>{{ site.title }} · {{ buildYear }}</p>
      <a href="{{ '/feed.xml' | url }}">Atom</a>
    </footer>
  </body>
</html>
